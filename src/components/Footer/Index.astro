---
import type { Language } from '@/i18n/config'
import Button from '@/components/Button.astro'
import Navbar from '@/components/Navbar.astro'
import Copyright from '@/components/Footer/Copyright.astro'
import PoweredBy from '@/components/Footer/PoweredBy.astro'
import SocialLinks from '@/components/Footer/SocialLinks.astro'
import { themeConfig } from '@/config'

const { supportedLangs = [] } = Astro.props as { supportedLangs?: Language[] }
const isLayoutCentered = themeConfig.global.layout === 'centered'
---

<footer
  class:list={[
    'text-3 leading-1.25em font-navbar lg:text-3.5',
    !isLayoutCentered
      ? 'lg:uno-desktop-column lg:bottom-20'
      : 'mt-16 pt-8 border-t border-secondary/20',
  ]}
>
  {!isLayoutCentered
    ? (
        <!-- Sidebar footer -->
        <>
          <SocialLinks />
          <Copyright />
          <PoweredBy />
        </>
      )
    : (
        <!-- Mobile centered footer -->
        <div class="lg:hidden flex flex-col gap-2">
          <div class="flex items-center justify-between order-first">
            <Navbar mode="footer" />
            <Button supportedLangs={supportedLangs} placement="footer" />
          </div>
          <div>
            <SocialLinks />
            <Copyright />
            <PoweredBy />
          </div>
        </div>

        <!-- Desktop centered footer -->
        <div class="max-lg:hidden flex flex-col gap-4">
          <div class="flex flex-row items-center justify-between">
            <div>
              <Copyright />
            </div>
            <div class="flex flex-row items-center gap-6">
              <Navbar mode="footer" />
              <Button supportedLangs={supportedLangs} placement="footer" />
            </div>
            <div>
              <SocialLinks />
            </div>
          </div>
          <div class="text-center">
            <PoweredBy />
          </div>
        </div>
      )
  }
</footer>
